# Copy to .env.local (never commit .env.local).
# Supabase → Project Settings → API. The anon key is safe to ship to browsers;
# it only works within row-level security. NEVER put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Set to true once an SMS provider (MSG91 / Twilio) is configured in Supabase Auth.
VITE_ENABLE_PHONE_AUTH=false
